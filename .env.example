NEXT_PUBLIC_SITE_URL=https://craftsprint.com
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Contact form email delivery — get a free key at https://resend.com (3,000 emails/month free)
# Without this key, contact messages are only logged to the server console, not emailed.
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Secret used to sign login sessions for Sign up / Log in. Set a long random value in production,
# e.g. generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-with-a-long-random-string
