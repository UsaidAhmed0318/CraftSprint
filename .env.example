NEXT_PUBLIC_SITE_URL=https://www.craftsprint.io
# Production URL. On Vercel this is filled in automatically from your production domain if left empty.
# AdSense: publisher ID and one display ad slot ID (AdSense → Ads → By ad unit).
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_ADSENSE_SLOT=1234567890
# Optional: Google Analytics 4 Measurement ID. Defaults to G-4N6T8DLQ7B built into app/layout.tsx.
NEXT_PUBLIC_GA_ID=

# Contact form email delivery — get a free key at https://resend.com (3,000 emails/month free)
# Without this key, contact messages are only logged to the server console, not emailed.
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Where contact-form messages are emailed (defaults to the email in lib/site.ts).
CONTACT_EMAIL=

# Optional: shared rate limits across all Vercel instances (free at upstash.com). Without these,
# limits are kept per server instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# Optional: Pinterest website claim (Pinterest → Settings → Claimed accounts → Websites → HTML tag → the content value).
NEXT_PUBLIC_PINTEREST_VERIFY=
