NEXT_PUBLIC_SITE_URL=https://craftsprint.com
# Production URL. On Vercel this is filled in automatically from your production domain if left empty.
# AdSense: publisher ID and one display ad slot ID (AdSense → Ads → By ad unit).
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_ADSENSE_SLOT=1234567890
# Optional: defaults to the Tag Manager container GTM-NN65653V built into app/layout.tsx. Accepts G-XXXX or GTM-XXXX.
NEXT_PUBLIC_GA_ID=

# Contact form email delivery — get a free key at https://resend.com (3,000 emails/month free)
# Without this key, contact messages are only logged to the server console, not emailed.
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Optional: turns the Tool Assistant into a real AI assistant (Claude). Without it, the assistant uses built-in keyword matching.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5

# Where contact-form messages are emailed (defaults to the email in lib/site.ts).
CONTACT_EMAIL=

# Optional: shared rate limits across all Vercel instances (free at upstash.com). Without these,
# limits are kept per server instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# CraftSprint AI "Chat with AI": Google Gemini free tier (aistudio.google.com/apikey). Used first if set.
GEMINI_API_KEY=
# Optional: a specific Gemini model; default is Google's latest Flash alias.
GEMINI_MODEL=

# More AI providers for CraftSprint AI. Set any/all: every key that is set is used, and with 2+ keys the
# answers are combined into one better reply. If one is down or out of free quota, the next one answers.
# Free keys: Groq console.groq.com/keys · OpenRouter openrouter.ai/keys (free models) ·
#            Mistral console.mistral.ai · Cerebras cloud.cerebras.ai
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
CEREBRAS_API_KEY=
OPENAI_API_KEY=
# Optional model overrides: GROQ_MODEL, OPENROUTER_MODEL, MISTRAL_MODEL, CEREBRAS_MODEL, OPENAI_MODEL
# Set AI_ENSEMBLE=off to answer with one provider at a time instead of combining several.
AI_ENSEMBLE=
